/*
 * at91-centurysys-gemini-06-overlay.dtso - Device Tree Overlay for Century Systems Gemini board
 *
 * Copyright (C) 2022-2026 Century Systems
 */
/dts-v1/;
/plugin/;
#include "sama5d2-pinfunc.h"
#include <dt-bindings/mfd/atmel-flexcom.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/at91.h>

/ {
	compatible = "atmel,sama5d2-gemini", "atmel,sama5d2", "atmel,sama5";
};

&pioA {
	pinctrl_flx3_uart_default: flx3_usart_default {
		pinmux = <PIN_PC20__FLEXCOM3_IO0>, /* TX */
			 <PIN_PC19__FLEXCOM3_IO1>; /* RX */
		bias-disable;
	};
};

/ {
	vadc_fixed: regulator-adc {
		compatible = "regulator-fixed";
		regulator-name = "VADC_5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};
};

&flx3 {
	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_USART>;
	status = "okay";
};

/* uart8 is the FLX3 USART child in Linux 6.12. */
&uart8 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flx3_uart_default>;
	status = "okay";
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	/* Water Meter Option (xio_id: 0x06) */
	ltc2487: ltc2487@14 {
		compatible = "lltc,ltc2487";
		reg = <0x14>;
		vref-supply = <&vadc_fixed>;
	};

	tca9538: tca9538@70 {
		compatible = "nxp,pca9538";
		reg = <0x70>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "eFUSE_SHDN_N",
				  "eFUSE_FLT_N",
				  "Reserved2",
				  "Reserved3",
				  "DISO_PDIS_N",
				  "Reserved5",
				  "Reserved6",
				  "TXD_Enable";
	};
};

&leds {
	tca953x_efuse_shdn_n {
		label = "VOUT_CTRL";
		gpios = <&tca9538 0 GPIO_ACTIVE_HIGH>;
	};

	tca953x_adc_vcc_on {
		label = "ADC_VCC_ON";
		gpios = <&tca9538 4 GPIO_ACTIVE_HIGH>;
		default-state = "on";
	};

	tca953x_txd_enable {
		label = "TXD_Enable";
		gpios = <&tca9538 7 GPIO_ACTIVE_LOW>;
	};
};

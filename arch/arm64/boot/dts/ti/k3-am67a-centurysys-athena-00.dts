 * Schematics: https://www.ti.com/lit/zip/sprr495
 */

/dts-v1/;

#include <dt-bindings/net/ti-dp83867.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/input/linux-event-codes.h>
#include "k3-j722s.dtsi"
#include "k3-serdes.h"

#include "k3-timesync-router.h"

/ {
	compatible = "centurysys,athena", "ti,j722s";
	model = "Century Systems MA-X4xx";

	chosen {
		stdout-path = "serial2:115200n8";
		//bootargs = "console=ttyS2,115200n8 earlycon=ns16550a,mmio32,0x02800000";
		bootargs = "console=ttyS2,115200n8";
	};

	aliases {
		serial0 = &wkup_uart0;
		serial2 = &main_uart0; /* console */
		serial3 = &main_uart1; /* RS-232C */
		serial4 = &main_uart2; /* RS-485 */
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
		ethernet0 = &cpsw_port1;
		ethernet1 = &cpsw_port2;
		i2c0 = &main_i2c0;
		i2c1 = &main_i2c1;
		i2c2 = &main_i2c2;
		i2c3 = &wkup_i2c0;
	};

	chosen {
		stdout-path = &main_uart0;
	};

	memory@80000000 {
		/* 8G RAM */
		reg = <0x00000000 0x80000000 0x00000000 0x80000000>,
		      <0x00000008 0x80000000 0x00000001 0x80000000>;
		device_type = "memory";
		bootph-pre-ram;
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* global cma region */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x38000000>;
			linux,cma-default;
		};

		secure_tfa_ddr: tfa@9e780000 {
			reg = <0x00 0x9e780000 0x00 0x80000>;
			no-map;
		};

		secure_ddr: optee@9e800000 {
			reg = <0x00 0x9e800000 0x00 0x01800000>;
			no-map;
		};

		wkup_r5fss0_core0_dma_memory_region: memory@a0000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa0000000 0x00 0x100000>;
			no-map;
		};

		wkup_r5fss0_core0_memory_region: memory@a0100000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa0100000 0x00 0xf00000>;
			no-map;
		};
	};

	vmain_pd: regulator-0 {
		/* TPS65988 PD CONTROLLER OUTPUT */
		compatible = "regulator-fixed";
		regulator-name = "vmain_pd";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
		bootph-all;
	};

	vsys_5v0: regulator-vsys5v0 {
		/* Output of LM5140 */
		compatible = "regulator-fixed";
		regulator-name = "vsys_5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vmain_pd>;
		regulator-always-on;
		regulator-boot-on;
	};

	vsys_3v3: regulator-vsys3v3 {
		/* output of LM5141-Q1 */
		compatible = "regulator-fixed";
		regulator-name = "vsys_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vmain_pd>;
		regulator-always-on;
		regulator-boot-on;
	};

	vdd_mmc1: regulator-mmc1 {
		/* TPS22918DBVR */
		compatible = "regulator-fixed";
		regulator-name = "vdd_mmc1";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		enable-active-high;
		bootph-all;
	};

	vsys_3v3_exp: regulator-TPS22990 {
		/* output of TPS22990 */
		compatible = "regulator-fixed";
		regulator-name = "vsys_3v3_exp";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vsys_3v3>;
		regulator-always-on;
		regulator-boot-on;
	};

	vdd_sd_dv: regulator-TLV71033 {
		compatible = "regulator-gpio";
		regulator-name = "tlv71033";
		pinctrl-names = "default";
		pinctrl-0 = <&vdd_sd_dv_pins_default>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		vin-supply = <&vsys_5v0>;
		gpios = <&main_gpio1 23 GPIO_ACTIVE_HIGH>;
		states = <1800000 0x0>,
			 <3300000 0x1>;
	};

	vsys_io_3v3: regulator-vsys-io-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vsys_io_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vsys_io_1v8: regulator-vsys-io-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vsys_io_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vsys_io_1v2: regulator-vsys-io-1v2 {
		compatible = "regulator-fixed";
		regulator-name = "vsys_io_1v2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
		regulator-boot-on;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&system_led_pins_default
			     &mcu_system_led_pins_default>;

		usb_hub_reset {
			label = "USBHub_Reset";
			gpios = <&main_gpio0 15 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_power_g {
			label = "PowerLED:G";
			gpios = <&main_gpio0 16 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_drv_enable {
			label = "LED_Drv_Enable";
			gpios = <&main_gpio0 18 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		se050_enable {
			label = "SE050_Enable";
			gpios = <&main_gpio0 19 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		eth_phy0_reset {
			label = "PHY0_Reset";
			gpios = <&main_gpio0 20 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		eth_phy1_reset {
			label = "PHY1_Reset";
			gpios = <&main_gpio0 21 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		shutdown_req {
			label = "SHUTDOWN_REQ";
			gpios = <&main_gpio0 41 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "cpu";
		};

		console_enable {
			label = "ConsoleEnable";
			gpios = <&main_gpio0 42 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		msp430_reset {
			label = "MSP430_RST";
			gpios = <&main_gpio0 49 GPIO_ACTIVE_HIGH>;
		};

		msp430_test {
			label = "MSP430_TEST";
			gpios = <&main_gpio0 50 GPIO_ACTIVE_HIGH>;
		};

		pcie_reset {
			label = "PCIe_Reset";
			gpios = <&mcu_gpio0 6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_g1 {
			label = "MobileLED_G1";
			gpios = <&gpio_exp0 0 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_g2 {
			label = "MobileLED_G2";
			gpios = <&gpio_exp0 1 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_g3 {
			label = "MobileLED_G3";
			gpios = <&gpio_exp0 2 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_r1 {
			label = "MobileLED_R1";
			gpios = <&gpio_exp0 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_r2 {
			label = "MobileLED_R2";
			gpios = <&gpio_exp0 4 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_r3 {
			label = "MobileLED_R3";
			gpios = <&gpio_exp0 5 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_mobile_power {
			label = "MobilePower";
			gpios = <&gpio_exp0 8 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_mobile_reset {
			label = "Mobile_RESETN";
			gpios = <&gpio_exp0 14 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "oneshot";
			led-pattern = <500 100>;
		};

		led_mobile_pwrkey {
			label = "Mobile_PWRKEY";
			gpios = <&gpio_exp0 15 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_dout_s0 {
			label = "DO_S0";
			gpios = <&main_gpio1 24 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	leds_msp430: leds-msp430 {
		mobile_power_msp430 {
			label = "Mobile_Power_MSP430";
			gpios = <&io_exp 0 GPIO_ACTIVE_HIGH>;
			retain-state-suspended;
			retain-state-shutdown;
			default-state = "keep";
		};

		led_sim_sel {
			label = "SIM_Sel";
			gpios = <&io_exp 7 GPIO_ACTIVE_HIGH>;
			retain-state-suspended;
			retain-state-shutdown;
			default-state = "keep";
		};
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&init_sw_pins_default
			     &opt_sw_pins_default
			     &mcu_dipsw_pins_default>;

		init_sw: init_sw {
			label = "INIT_SW";
			linux,code = <BTN_0>;
			gpios = <&main_gpio0 35 GPIO_ACTIVE_LOW>;
		};

		opt_sw: opt_sw {
			label = "OPT_SW";
			linux,code = <BTN_1>;
			gpios = <&main_gpio0 32 GPIO_ACTIVE_HIGH>;
		};

		dipsw0: dipsw0 {
			label = "DIPSW0";
			linux,code = <BTN_2>;
			gpios = <&mcu_gpio0 13 GPIO_ACTIVE_HIGH>;
		};

		dipsw1: dipsw1 {
			label = "DIPSW1";
			linux,code = <BTN_3>;
			gpios = <&mcu_gpio0 14 GPIO_ACTIVE_HIGH>;
		};

		dipsw2: dipsw2 {
			label = "DIPSW2";
			linux,code = <BTN_4>;
			gpios = <&mcu_gpio0 15 GPIO_ACTIVE_HIGH>;
		};

		dipsw3: dipsw3 {
			label = "DIPSW3";
			linux,code = <BTN_5>;
			gpios = <&mcu_gpio0 16 GPIO_ACTIVE_HIGH>;
		};
	};
};

&cpsw_mac_syscon {
	bootph-all;
};

&phy_gmii_sel {
	bootph-all;
};

&main_pmx0 {
	main_i2c0_pins_default: main-i2c0-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x01e0, PIN_INPUT_PULLUP, 0)	/* (D23) I2C0_SCL */
			J722S_IOPAD(0x01e4, PIN_INPUT_PULLUP, 0)	/* (B22) I2C0_SDA */
		>;
		bootph-all;
	};

	main_i2c1_pins_default: main-i2c1-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x01e8, PIN_INPUT_PULLUP, 0)	/* (C24) I2C1_SCL */
			J722S_IOPAD(0x01ec, PIN_INPUT_PULLUP, 0)	/* (A22) I2C1_SDA */
		>;
		bootph-all;
	};

	main_i2c2_pins_default: main-i2c2-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x00b0, PIN_INPUT_PULLUP, 1)	/* (P22) GPMC0_CSn2.I2C2_SCL */
			J722S_IOPAD(0x00b4, PIN_INPUT_PULLUP, 1)	/* (P23) GPMC0_CSn3.I2C2_SDA */
		>;
	};

	main_uart0_pins_default: main-uart0-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x01c8, PIN_INPUT, 0)		/* (A22) UART0_RXD */
			J722S_IOPAD(0x01cc, PIN_OUTPUT, 0)		/* (B22) UART0_TXD */
		>;
		bootph-all;
	};

	main_uart1_pins_default: main-uart1-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x01ac, PIN_INPUT, 2)		/* (C27) MCASP0_AFSR.UART1_RXD */
			J722S_IOPAD(0x01b0, PIN_OUTPUT, 2)		/* (F24) MCASP0_ACLKR.UART1_TXD */
			J722S_IOPAD(0x0194, PIN_INPUT, 2)		/* (A25) MCASP0_AXR3.UART1_CTSn */
			J722S_IOPAD(0x0198, PIN_OUTPUT, 2)		/* (A26) MCASP0_AXR2.UART1_RTSn */
			J722S_IOPAD(0x01a0, PIN_OUTPUT, 7)		/* (F23) MCASP0_AXR0.GPIO1_10 */
			J722S_IOPAD(0x019c, PIN_INPUT, 7)		/* (B25) MCASP0_AXR1.GPIO1_9 */
			J722S_IOPAD(0x01a4, PIN_INPUT, 7)		/* (D25) MCASP0_ACLKX.GPIO1_11 */
			J722S_IOPAD(0x01a8, PIN_INPUT, 7)		/* (C26) MCASP0_AFSX.GPIO1_12 */
		>;
		bootph-all;
	};

	main_uart2_pins_default: main-uart2-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x005c, PIN_INPUT, 2)		/* (U27) GPMC0_AD8.UART2_RXD */
			J722S_IOPAD(0x0060, PIN_OUTPUT, 2)		/* (U26) GPMC0_AD9.UART2_TXD */
			J722S_IOPAD(0x0078, PIN_OUTPUT, 7)		/* (V23) GPMC0_AD15.GPIO0_30 */
		>;
		bootph-all;
	};

	main_uart3_pins_default: main-uart3-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0064, PIN_INPUT, 2)		/* (V27) GPMC0_AD10.UART3_RXD */
			J722S_IOPAD(0x0068, PIN_OUTPUT, 2)		/* (V25) GPMC0_AD11.UART3_TXD */
		>;
		bootph-all;
	};

	main_uart5_pins_default: main-uart5-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0108, PIN_INPUT, 3)       /* (J27) UART5_RXD */
			J722S_IOPAD(0x010c, PIN_OUTPUT, 3)      /* (H27) UART5_TXD */
		>;
	};

	vdd_sd_dv_pins_default: vdd-sd-dv-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x01d4, PIN_OUTPUT, 7) /* (B21) UART0_RTSn.GPIO1_23 */
		>;
		bootph-all;
	};

	main_mmc1_pins_default: main-mmc1-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x023c, PIN_INPUT, 0)	/* (H22) MMC1_CMD */
			J722S_IOPAD(0x0234, PIN_OUTPUT, 0)	/* (H24) MMC1_CLK */
			J722S_IOPAD(0x0230, PIN_INPUT, 0)	/* (H23) MMC1_DAT0 */
			J722S_IOPAD(0x022c, PIN_INPUT, 0)	/* (H20) MMC1_DAT1 */
			J722S_IOPAD(0x0228, PIN_INPUT, 0)	/* (J23) MMC1_DAT2 */
			J722S_IOPAD(0x0224, PIN_INPUT, 0)	/* (H25) MMC1_DAT3 */
			J722S_IOPAD(0x0240, PIN_INPUT, 0)	/* (B24) MMC1_SDCD */
			J722S_IOPAD(0x0244, PIN_INPUT, 0)	/* (A24) MMC1_SDWP */
		>;
		bootph-all;
	};

	mdio_pins_default: mdio-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0160, PIN_OUTPUT, 0)	/* (AC24) MDIO0_MDC */
			J722S_IOPAD(0x015c, PIN_INPUT, 0)	/* (AD25) MDIO0_MDIO */
		>;
		bootph-all;
	};

	ospi0_pins_default: ospi0-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0000, PIN_OUTPUT, 0)	/* (L24) OSPI0_CLK */
			J722S_IOPAD(0x002c, PIN_OUTPUT, 0)	/* (K26) OSPI0_CSn0 */
			J722S_IOPAD(0x000c, PIN_INPUT, 0)	/* (K27) OSPI0_D0 */
			J722S_IOPAD(0x0010, PIN_INPUT, 0)	/* (L27) OSPI0_D1 */
			J722S_IOPAD(0x0014, PIN_INPUT, 0)	/* (L26) OSPI0_D2 */
			J722S_IOPAD(0x0018, PIN_INPUT, 0)	/* (L25) OSPI0_D3 */
			J722S_IOPAD(0x0008, PIN_INPUT, 0)	/* (L22) OSPI0_DQS */
			J722S_IOPAD(0x0004, PIN_OUTPUT, 0)	/* (L23) OSPI0_LBCLKO */
		>;
		bootph-all;
	};

	rgmii1_pins_default: rgmii1-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x014c, PIN_INPUT, 0)	/* (AC25) RGMII1_RD0 */
			J722S_IOPAD(0x0150, PIN_INPUT, 0)	/* (AD27) RGMII1_RD1 */
			J722S_IOPAD(0x0154, PIN_INPUT, 0)	/* (AE24) RGMII1_RD2 */
			J722S_IOPAD(0x0158, PIN_INPUT, 0)	/* (AE26) RGMII1_RD3 */
			J722S_IOPAD(0x0148, PIN_INPUT, 0)	/* (AE27) RGMII1_RXC */
			J722S_IOPAD(0x0144, PIN_INPUT, 0)	/* (AD23) RGMII1_RX_CTL */
			J722S_IOPAD(0x0134, PIN_OUTPUT, 0)	/* (AF27) RGMII1_TD0 */
			J722S_IOPAD(0x0138, PIN_OUTPUT, 0)	/* (AE23) RGMII1_TD1 */
			J722S_IOPAD(0x013c, PIN_OUTPUT, 0)	/* (AG25) RGMII1_TD2 */
			J722S_IOPAD(0x0140, PIN_OUTPUT, 0)	/* (AF24) RGMII1_TD3 */
			J722S_IOPAD(0x0130, PIN_OUTPUT, 0)	/* (AG26) RGMII1_TXC */
			J722S_IOPAD(0x012c, PIN_OUTPUT, 0)	/* (AF25) RGMII1_TX_CTL */
		>;
		bootph-all;
	};

	rgmii2_pins_default: rgmii2-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x00f8, PIN_INPUT, 2)	/* (AB24) VOUT0_HSYNC.RGMII2_RD0 */
			J722S_IOPAD(0x00fc, PIN_INPUT, 2)	/* (AC27) VOUT0_DE.RGMII2_RD1 */
			J722S_IOPAD(0x0100, PIN_INPUT, 2)	/* (AB23) VOUT0_VSYNC.RGMII2_RD2 */
			J722S_IOPAD(0x0104, PIN_INPUT, 2)	/* (AC26) VOUT0_PCLK.RGMII2_RD3 */
			J722S_IOPAD(0x00f4, PIN_INPUT, 2)	/* (AB27) VOUT0_DATA15.RGMII2_RXC */
			J722S_IOPAD(0x00f0, PIN_INPUT, 2)	/* (AB26) VOUT0_DATA14.RGMII2_RX_CTL */
			J722S_IOPAD(0x00e0, PIN_OUTPUT, 2)	/* (AA25) VOUT0_DATA10.RGMII2_TD0 */
			J722S_IOPAD(0x00e4, PIN_OUTPUT, 2)	/* (AB25) VOUT0_DATA11.RGMII2_TD1 */
			J722S_IOPAD(0x00e8, PIN_OUTPUT, 2)	/* (AA23) VOUT0_DATA12.RGMII2_TD2 */
			J722S_IOPAD(0x00ec, PIN_OUTPUT, 2)	/* (AA22) VOUT0_DATA13.RGMII2_TD3 */
			J722S_IOPAD(0x00dc, PIN_OUTPUT, 2)	/* (AA27) VOUT0_DATA9.RGMII2_TXC */
			J722S_IOPAD(0x00d8, PIN_OUTPUT, 2)	/* (AA24) VOUT0_DATA8.RGMII2_TX_CTL */
		>;
		bootph-all;
	};

	main_usb0_pins_default: main-usb0-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0254, PIN_OUTPUT, 0)	/* (E25) USB0_DRVVBUS */
		>;
	};

	main_usb1_pins_default: main-usb1-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0258, PIN_INPUT, 0)	/* (B27) USB1_DRVVBUS */
		>;
	};

	pmic_irq_pins_default: pmic-irq-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x01f4, PIN_INPUT, 0)	/* (B23) EXTINTn */
		>;
	};

	system_led_pins_default: system-led-pins-default {
		pinctrl-single,pins = <
			J722S_IOPAD(0x003c, PIN_OUTPUT, 7)	/* (R22) GPMC0_AD0.GPIO0_15 */
			J722S_IOPAD(0x0040, PIN_OUTPUT, 7)	/* (R23) GPMC0_AD1.GPIO0_16 */
			J722S_IOPAD(0x0048, PIN_OUTPUT, 7)	/* (T27) GPMC0_AD3.GPIO0_18 */
			J722S_IOPAD(0x004c, PIN_OUTPUT, 7)	/* (T25) GPMC0_AD4.GPIO0_19 */
			J722S_IOPAD(0x0050, PIN_OUTPUT, 7)	/* (T24) GPMC0_AD5.GPIO0_20 */
			J722S_IOPAD(0x0054, PIN_OUTPUT, 7)	/* (T21) GPMC0_AD6.GPIO0_21 */
			J722S_IOPAD(0x00a8, PIN_OUTPUT, 7)	/* (R27) GPMC0_CSn0.GPIO0_41 */
			J722S_IOPAD(0x00ac, PIN_OUTPUT, 7)	/* (P21) GPMC0_CSn1.GPIO0_42 */
			J722S_IOPAD(0x01d8, PIN_OUTPUT, 7)	/* (D22) MCAN0_TX.GPIO1_24 */
			J722S_IOPAD(0x00c8, PIN_OUTPUT, 7)	/* (W22) VOUT0_DATA4.GPIO0_49 */
			J722S_IOPAD(0x00cc, PIN_OUTPUT, 7)	/* (W21) VOUT0_DATA5.GPIO0_50 */
		>;
	};

	init_sw_pins_default: init-sw-pins-default {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0090, PIN_INPUT, 7)	/* (P27) GPMC0_BE0n_CLE.GPIO0_35 */
		>;
	};

	opt_sw_pins_default: opt-sw-pins-default {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0084, PIN_INPUT, 7)	/* (N21) GPMC0_ADVn_ALE.GPIO0_32 */
		>;
	};
};

&cpsw3g {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii1_pins_default
		     &rgmii2_pins_default>;

	cpts@3d000 {
		/* MAP HW3_TS_PUSH to GENF1 */
		ti,pps = <2 1>;
	};
};

&cpsw3g_mdio {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins_default>;

	cpsw3g_phy0: ethernet-phy@0 {
		reg = <2>;
		bootph-all;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,min-output-impedance;
	};

	cpsw3g_phy1: ethernet-phy@1 {
		reg = <3>;
		bootph-all;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,min-output-impedance;
	};
};

&cpsw_port1 {
	phy-mode = "rgmii-rxid";
	phy-handle = <&cpsw3g_phy0>;
	status = "okay";
	bootph-all;
};

&cpsw_port2 {
	phy-mode = "rgmii-rxid";
	phy-handle = <&cpsw3g_phy1>;
	status = "okay";
	bootph-all;
};

&main_gpio0 {
	gpio-line-names = "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "INIT_SW", "", "USBHUB_RESET_N",
			  "POWER_LED_G", "", "LEDDRV_EN", "SE050_ENA", "CPSW_RGMII1_RESET_N", "CPSW_RGMII2_RESET_N", "", "",
			  "", "", "", "", "", "", "RS485_TXEN", "MSP430_IRQ_N",
			  "OPT_SWITCH", "CPSW_RGMII1_INT_N", "XIO_IRQ1_N", "INIT_SWITCH_N", "", "CPSW_RGMII2_INT_N", "XIO_IRQ0_N", "XIO_IRQ2_N",
			  "RTC_IRQ_N", "MSP430_SHDN_N", "EXT_CONSOLE_ENB", "", "", "DIN_S1", "DIN_S0", "DIN_T1",
			  "DIN_T0", "MSP430_RST", "MSP430_TEST", "", "", "", "", "",
			  "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "", "", "MMC0_RST_N",
			  "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "";
	status = "okay";
};

&main_gpio1 {
	gpio-line-names = "", "", "", "", "", "", "", "",
			  "", "RS232_UART1_DSR", "RS232_UART1_DTR", "RS232_UART1_CD", "RS232_UART1_RI", "", "", "",
			  "", "", "", "", "", "", "USB1_OVC_N", "PMIC_VSEL_SD",
			  "DOUT_S0", "DOUT_T0", "", "", "", "", "", "",
			  "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "", "", "",
			  "";
	status = "okay";
};

&main_uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart0_pins_default>;
	dsr-gpios = <&main_gpio1 9 GPIO_ACTIVE_LOW>;
	dtr-gpios = <&main_gpio1 10 GPIO_ACTIVE_LOW>;
	dcd-gpios = <&main_gpio1 11 GPIO_ACTIVE_LOW>;
	rng-gpios = <&main_gpio1 12 GPIO_ACTIVE_LOW>;
	status = "okay";
	bootph-all;
};

&main_uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart1_pins_default>;
	status = "okay";
	bootph-all;
};

&main_uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart2_pins_default>;
	linux,rs485-enabled-at-boot-time;
	rts-gpios = <&main_gpio0 30 GPIO_ACTIVE_HIGH>;
	status = "okay";
	bootph-all;
};

&main_uart5 {
	/* MAIN UART 5 is used by System firmware */
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart5_pins_default>;
	status = "reserved";
};

&mcu_pmx0 {
	mcu_i2c0_pins_default: mcu-i2c0-default-pins {
		pinctrl-single,pins = <
			J722S_MCU_IOPAD(0x048, PIN_INPUT, 0)		/* (E11) MCU_I2C0_SDA */
			J722S_MCU_IOPAD(0x044, PIN_INPUT, 0)		/* (B13) MCU_I2C0_SCL */
		>;
	};

	wkup_uart0_pins_default: wkup-uart0-default-pins {
		pinctrl-single,pins = <
			J722S_MCU_IOPAD(0x02c, PIN_INPUT, 0)		/* (C7) WKUP_UART0_CTSn */
			J722S_MCU_IOPAD(0x030, PIN_OUTPUT, 0)		/* (C6) WKUP_UART0_RTSn */
			J722S_MCU_IOPAD(0x024, PIN_INPUT, 0)		/* (D8) WKUP_UART0_RXD */
			J722S_MCU_IOPAD(0x028, PIN_OUTPUT, 0)		/* (D7) WKUP_UART0_TXD */
		>;
		bootph-all;
	};

	wkup_i2c0_pins_default: wkup-i2c0-default-pins {
		pinctrl-single,pins = <
			J722S_MCU_IOPAD(0x04c, PIN_INPUT_PULLUP, 0)	/* (C7) WKUP_I2C0_SCL */
			J722S_MCU_IOPAD(0x050, PIN_INPUT_PULLUP, 0)	/* (C6) WKUP_I2C1_SDA */
		>;
		bootph-all;
	};

	mcu_dipsw_pins_default: mcu-dipsw-default-pins {
		pinctrl-single,pins = <
			J722S_MCU_IOPAD(0x0034, PIN_INPUT, 7)		/* (B2) MCU_MCAN0_TX.MCU_GPIO0_13 */
			J722S_MCU_IOPAD(0x0038, PIN_INPUT, 7)		/* (D8) MCU_MCAN0_RX.MCU_GPIO0_14 */
			J722S_MCU_IOPAD(0x003c, PIN_INPUT, 7)		/* (C1) MCU_MCAN1_TX.MCU_GPIO0_15 */
			J722S_MCU_IOPAD(0x0040, PIN_INPUT, 7)		/* (B1) MCU_MCAN1_RX.MCU_GPIO0_16 */
		>;
	};

	mcu_system_led_pins_default: mcu_system-led-pins-default {
		pinctrl-single,pins = <
			J722S_MCU_IOPAD(0x0018, PIN_OUTPUT, 7)		/* (B4) MCU_UART0_TXD.MCU_GPIO0_6 */
		>;
	};
};

&wkup_uart0 {
	/* WKUP UART0 is used by Device Manager firmware */
	pinctrl-names = "default";
	pinctrl-0 = <&wkup_uart0_pins_default>;
	status = "reserved";
	bootph-all;
};

&wkup_i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&wkup_i2c0_pins_default>;
	clock-frequency = <400000>;
	status = "okay";
	bootph-all;

	tps65219: pmic@30 {
		compatible = "ti,tps65219";
		reg = <0x30>;
		buck1-supply = <&vsys_5v0>;
		buck2-supply = <&vsys_5v0>;
		buck3-supply = <&vsys_5v0>;
		ldo1-supply = <&vsys_io_3v3>;
		ldo3-supply = <&vsys_io_3v3>;
		ldo4-supply = <&vsys_io_3v3>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_irq_pins_default>;
		interrupt-parent = <&gic500>;
		interrupts = <GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;

		bootph-all;
		system-power-controller;
		ti,power-button;

		regulators {
			buck1_reg: buck1 {
				regulator-name = "VDD_3V3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck2_reg: buck2 {
				regulator-name = "VDD_1V8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1_reg: ldo1 {
				regulator-name = "VDDSHV5_SDIO";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-allow-bypass;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo2_reg: ldo2 {
				regulator-name = "VDD_1V2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo3_reg: ldo3 {
				regulator-name = "VDDA_PHY_1V8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4_reg: ldo4 {
				regulator-name = "VDDA_PLL_1V8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};

	tps62873a: regulator@40 {
		compatible = "ti,tps62873";
		reg = <0x40>;
		bootph-pre-ram;
		regulator-name = "VDD_CPU_AVS";
		regulator-min-microvolt = <600000>;
		regulator-max-microvolt = <900000>;
		regulator-boot-on;
		regulator-always-on;
	};

	tps62873b: regulator@43 {
		compatible = "ti,tps62873";
		reg = <0x43>;
		regulator-name = "VDD_CORE_0V8";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	rtc: rtc@32 {
		compatible = "dsk324sr";
		reg = <0x32>;
	};

	eeprom@50 {
		compatible = "atmel,24mac402";
		reg = <0x50>;
	};
};

&main_i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c0_pins_default>;
	clock-frequency = <400000>;
	status = "okay";

	tca6507: led@45 {
		compatible = "ti,tca6507";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x45>;

		led0: power-status-red@0 {
			label = "power-stat:r";
			reg = <0x0>;
		};

		led1: system-status1-red@1 {
			label = "system-status1:r";
			reg = <0x1>;
			linux,default-trigger = "heartbeat";
		};

		led2: system-status2-red@2 {
			label = "system-status2:r";
			reg = <0x2>;
		};

		led3: system-status3-red@3 {
			label = "system-status3:r";
			reg = <0x3>;
		};

		led4: system-status1-green@4 {
			label = "system-status1:g";
			reg = <0x4>;
			linux,default-trigger = "timer-suspend";
		};

		led5: system-status2-green@5 {
			label = "system-status2:g";
			reg = <0x5>;
		};

		led6: system-status3-green@6 {
			label = "system-status3:g";
			reg = <0x6>;
		};
	};

	adc@49 {
		compatible = "ti,tla2021";
		reg = <0x49>;
		#address-cells = <1>;
		#size-cells = <0>;

		channel@0 {	/* Voltage over AIN0 and AIN1. */
			reg = <0>;
		};
	};

	temp_senser: tmp75b@4a {
		compatible = "ti,tmp75b";
		reg = <0x4a>;
	};

	gpio_exp0: gpio_exp0@74 {
		compatible = "nxp,pca9539";
		reg = <0x74>;
		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names = "MobileLED:G0",
				  "MobileLED:G1",
				  "MobileLED:G2",
				  "MobileLED:R0",
				  "MobileLED:R1",
				  "MobileLED:R2",
				  "SIM_CD",
				  "SIM2_CD",
				  "MobilePower",
				  "Mobile_Wakeup_N",
				  "SIM2_Board_Detect",
				  "", "",
				  "Mobile_Status_N",
				  "Mobile_Reset",
				  "Mobile_PWRKEY";
	};
};

&main_i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c1_pins_default>;
	clock-frequency = <400000>;
	status = "okay";

	io_exp: io_exp@4d {
		compatible = "nxp,pca9698";
		reg = <0x4d>;
		#address-cells = <1>;
		#size-cells = <0>;
		#gpio-cells = <2>;

		gpio-line-names = "Mobile_Power_MSP430", "", "",
				  "", "", "", "", "SIM_Select",
				  "", "", "", "", "", "", "", "", /* Reserved */
				  "", "", "", "", "", "", "", "", /* Reserved */
				  "", "", "", "", "", "", "", "", /* Reserved */
				  "", "", "", "", "", "", "", ""; /* Reserved */
	};

	m41t80: rtc@68 {
		compatible = "st,m41t80";
		reg = <0x68>;
		wakeup-source;
	};
};

&main_i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c2_pins_default>;
	clock-frequency = <400000>;
	status = "okay";
};

&ospi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&ospi0_pins_default>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0x0>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <166000000>;
		cdns,tshsl-ns = <60>;
		cdns,tsd2d-ns = <60>;
		cdns,tchsh-ns = <60>;
		cdns,tslch-ns = <60>;
		cdns,read-delay = <4>;
		bootph-all;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "tiboot3";
				reg = <0x0 0x80000>;
			};

			partition@80000 {
				label = "tispl";
				reg = <0x80000 0x200000>;
			};

			partition@280000 {
				label = "u-boot";
				reg = <0x280000 0x200000>;
			};

			partition@480000 {
				label = "env";
				reg = <0x480000 0x20000>;
			};

			partition@4a0000 {
				label = "env.backup";
				reg = <0x4a0000 0x20000>;
			};

			partition@4c0000 {
				label = "boot.scr";
				reg = <0x4c0000 0x10000>;
			};

			partition@4d0000 {
				label = "reserved";
				reg = <0x4d0000 0x2b0000>;
			};

			partition@780000 {
				label = "hist_firmup";
				reg = <0x780000 0x40000>;
			};

			partition@7c0000 {
				label = "hist_boot";
				reg = <0x7c0000 0x40000>;
			};
		};
	};
};

&sdhci0 {
	disable-wp;
	bootph-all;
	ti,driver-strength-ohm = <50>;
	status = "okay";
};

&sdhci1 {
	/* SD/MMC */
	vmmc-supply = <&vsys_3v3>;
	vqmmc-supply = <&vdd_sd_dv>;
	pinctrl-names = "default";
	pinctrl-0 = <&main_mmc1_pins_default>;
	ti,driver-strength-ohm = <50>;
	disable-wp;
	status = "okay";
	bootph-all;
};

&serdes_ln_ctrl {
	idle-states = <J722S_SERDES0_LANE0_USB>,
		      <J722S_SERDES1_LANE0_PCIE0_LANE0>;
};

&serdes_wiz0 {
	status = "okay";
};

&serdes0 {
	serdes0_usb_link: phy@0 {
		reg = <0>;
		cdns,num-lanes = <1>;
		#phy-cells = <0>;
		cdns,phy-type = <PHY_TYPE_USB3>;
		resets = <&serdes_wiz0 1>;
	};
};

&serdes_refclk {
	clock-frequency = <100000000>;
};

&serdes_wiz1 {
	status = "okay";

	assigned-clocks = <&k3_clks 280 1>;
	assigned-clock-parents = <&k3_clks 280 3>; /* EXT_REFCLK1 */
};

&serdes1 {
	status = "okay";

	assigned-clocks = <&serdes_wiz1 TI_WIZ_PLL0_REFCLK>,
			  <&serdes_wiz1 TI_WIZ_PLL1_REFCLK>,
			  <&serdes_wiz1 TI_WIZ_REFCLK_DIG>;
	assigned-clock-parents = <&serdes_refclk>,
				 <&serdes_refclk>,
				 <&serdes_refclk>;

	serdes1_pcie_link: phy@0 {
		reg = <0>;
		cdns,num-lanes = <1>;
		#phy-cells = <0>;
		cdns,phy-type = <PHY_TYPE_PCIE>;
		resets = <&serdes_wiz1 1>;
	};
};

&pcie0_rc {
	clocks = <&k3_clks 259 0>;
	clock-names = "fck";

	phys = <&serdes1_pcie_link>;
	phy-names = "pcie-phy";
	status = "okay";
};

&usbss0 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_usb0_pins_default>;
	ti,vbus-divider;
	status = "okay";
};

&usb0 {
	dr_mode = "host";
	status = "okay";
};

&usb0_phy_ctrl {
	bootph-all;
};

&usbss1 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_usb1_pins_default>;
	ti,vbus-divider;
	status = "okay";
};

&usb1 {
	dr_mode = "host";
	maximum-speed = "super-speed";
	phys = <&serdes0_usb_link>;
	phy-names = "cdns3,usb3-phy";
};

&mcu_gpio0 {
	gpio-line-names = "", "", "", "", "DIP_SW4", "", "PCIE_RESET_N", "",
			  "PCIE_POWER_EN", "", "", "", "MOBILE_EXP_IRQ_N", "DIP_SW0", "DIP_SW1", "DIP_SW2",
			  "DIP_SW3", "", "", "", "", "", "", "";
	status = "okay";
};

&mcu_i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_i2c0_pins_default>;
	clock-frequency = <400000>;
	status = "okay";
};

&timesync_router {
	/* Use Time Sync Router to map GENF1 input to HW3_TS_PUSH output */
	mux-reg-mask-val = <
		/* pps [cpsw cpts genf1] in17 -> out12 [cpsw cpts hw3_push] */
		K3_TS_OFFSET(12, 0x0001ffff, 17)
		>;
	idle-states = <0x1>;
	status = "okay";
};

&gpu {
	status = "disabled";
};

//#include "k3-j722s-ti-ipc-firmware.dtsi"
